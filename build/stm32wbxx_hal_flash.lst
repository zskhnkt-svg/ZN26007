 454:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_flash.c **** 
 455:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_flash.c ****     /* verify Flash is unlock */
 456:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_flash.c ****     if (READ_BIT(FLASH->CR, FLASH_CR_LOCK) != 0U)
 457:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_flash.c ****     {
 458:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_flash.c ****       status = HAL_ERROR;
