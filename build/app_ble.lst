1198:STM32_WPAN/App/app_ble.c **** const uint8_t* BleGetBdAddress(void)
1199:STM32_WPAN/App/app_ble.c **** {
1200:STM32_WPAN/App/app_ble.c ****   uint8_t *p_otp_addr;
1201:STM32_WPAN/App/app_ble.c ****   const uint8_t *p_bd_addr;
1202:STM32_WPAN/App/app_ble.c ****   uint32_t udn;
1203:STM32_WPAN/App/app_ble.c ****   uint32_t company_id;
1204:STM32_WPAN/App/app_ble.c ****   uint32_t device_id;
1205:STM32_WPAN/App/app_ble.c **** 
1206:STM32_WPAN/App/app_ble.c ****   udn = LL_FLASH_GetUDN();
1207:STM32_WPAN/App/app_ble.c **** 
1208:STM32_WPAN/App/app_ble.c ****   if (udn != 0xFFFFFFFF)
1209:STM32_WPAN/App/app_ble.c ****   {
1210:STM32_WPAN/App/app_ble.c ****     company_id = LL_FLASH_GetSTCompanyID();
1211:STM32_WPAN/App/app_ble.c ****     device_id = LL_FLASH_GetDeviceID();
1212:STM32_WPAN/App/app_ble.c **** 
1213:STM32_WPAN/App/app_ble.c ****     /**
1214:STM32_WPAN/App/app_ble.c ****      * Public Address with the ST company ID
1215:STM32_WPAN/App/app_ble.c ****      * bit[47:24] : 24bits (OUI) equal to the company ID
1216:STM32_WPAN/App/app_ble.c ****      * bit[23:16] : Device ID.
1217:STM32_WPAN/App/app_ble.c ****      * bit[15:0] : The last 16bits from the UDN
1218:STM32_WPAN/App/app_ble.c ****      * Note: In order to use the Public Address in a final product, a dedicated
1219:STM32_WPAN/App/app_ble.c ****      * 24bits company ID (OUI) shall be bought.
1220:STM32_WPAN/App/app_ble.c ****      */
1221:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[0] = (uint8_t)(udn & 0x000000FF);
1222:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[1] = (uint8_t)((udn & 0x0000FF00) >> 8);
1223:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[2] = (uint8_t)device_id;
1224:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[3] = (uint8_t)(company_id & 0x000000FF);
1225:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[4] = (uint8_t)((company_id & 0x0000FF00) >> 8);
1226:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[5] = (uint8_t)((company_id & 0x00FF0000) >> 16);
1227:STM32_WPAN/App/app_ble.c **** 
1228:STM32_WPAN/App/app_ble.c ****     p_bd_addr = (const uint8_t *)a_BdAddrUdn;
ARM GAS  C:\Users\843E~1\AppData\Local\Temp\cc0NsbAf.s 			page 23


1229:STM32_WPAN/App/app_ble.c ****   }
1230:STM32_WPAN/App/app_ble.c ****   else
1231:STM32_WPAN/App/app_ble.c ****   {
1232:STM32_WPAN/App/app_ble.c ****     p_otp_addr = OTP_Read(0);
1233:STM32_WPAN/App/app_ble.c ****     if (p_otp_addr)
1234:STM32_WPAN/App/app_ble.c ****     {
1235:STM32_WPAN/App/app_ble.c ****       p_bd_addr = ((OTP_ID0_t*)p_otp_addr)->bd_address;
1236:STM32_WPAN/App/app_ble.c ****     }
1237:STM32_WPAN/App/app_ble.c ****     else
1238:STM32_WPAN/App/app_ble.c ****     {
1239:STM32_WPAN/App/app_ble.c ****       p_bd_addr = a_MBdAddr;
1240:STM32_WPAN/App/app_ble.c ****     }
1241:STM32_WPAN/App/app_ble.c ****   }
1242:STM32_WPAN/App/app_ble.c **** 
1243:STM32_WPAN/App/app_ble.c ****   return p_bd_addr;
1244:STM32_WPAN/App/app_ble.c **** }
