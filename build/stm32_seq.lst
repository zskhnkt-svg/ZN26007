 416:Utilities/sequencer/stm32_seq.c **** void UTIL_SEQ_WaitEvt(UTIL_SEQ_bm_t EvtId_bm)
 417:Utilities/sequencer/stm32_seq.c **** {
 418:Utilities/sequencer/stm32_seq.c ****   UTIL_SEQ_bm_t event_waited_id_backup;
 419:Utilities/sequencer/stm32_seq.c ****   UTIL_SEQ_bm_t current_task_idx;
 420:Utilities/sequencer/stm32_seq.c ****   UTIL_SEQ_bm_t wait_task_idx;
 421:Utilities/sequencer/stm32_seq.c ****   /*
 422:Utilities/sequencer/stm32_seq.c ****    * store in local the current_task_id_bm as the global variable CurrentTaskIdx
 423:Utilities/sequencer/stm32_seq.c ****    * may be overwritten in case there are nested call of UTIL_SEQ_Run()
 424:Utilities/sequencer/stm32_seq.c ****    */
 425:Utilities/sequencer/stm32_seq.c ****   current_task_idx = CurrentTaskIdx;
 426:Utilities/sequencer/stm32_seq.c ****   if(UTIL_SEQ_NOTASKRUNNING == CurrentTaskIdx)
 427:Utilities/sequencer/stm32_seq.c ****   {
 428:Utilities/sequencer/stm32_seq.c ****     wait_task_idx = 0u;
 429:Utilities/sequencer/stm32_seq.c ****   }
 430:Utilities/sequencer/stm32_seq.c ****   else
 431:Utilities/sequencer/stm32_seq.c ****   {
 432:Utilities/sequencer/stm32_seq.c ****     wait_task_idx = (uint32_t)1u << CurrentTaskIdx;
 433:Utilities/sequencer/stm32_seq.c ****   }
 434:Utilities/sequencer/stm32_seq.c **** 
 435:Utilities/sequencer/stm32_seq.c ****   /* backup the event id that was currently waited */
 436:Utilities/sequencer/stm32_seq.c ****   event_waited_id_backup = EvtWaited;
 437:Utilities/sequencer/stm32_seq.c ****   EvtWaited = EvtId_bm;
 438:Utilities/sequencer/stm32_seq.c ****   /*
 439:Utilities/sequencer/stm32_seq.c ****    * wait for the new event
ARM GAS  C:\Users\843E~1\AppData\Local\Temp\ccgjEjrR.s 			page 31


 440:Utilities/sequencer/stm32_seq.c ****    * note: that means that if the previous waited event occurs, it will not exit
 441:Utilities/sequencer/stm32_seq.c ****    * the while loop below.
 442:Utilities/sequencer/stm32_seq.c ****    * The system is waiting only for the last waited event.
 443:Utilities/sequencer/stm32_seq.c ****    * When it will go out, it will wait again from the previous one.
 444:Utilities/sequencer/stm32_seq.c ****    * It case it occurs while waiting for the second one, the while loop will exit immediately
 445:Utilities/sequencer/stm32_seq.c ****    */
 446:Utilities/sequencer/stm32_seq.c **** 
 447:Utilities/sequencer/stm32_seq.c ****   while ((EvtSet & EvtId_bm) == 0U)
 448:Utilities/sequencer/stm32_seq.c ****   {
 449:Utilities/sequencer/stm32_seq.c ****     UTIL_SEQ_EvtIdle(wait_task_idx, EvtId_bm);
 450:Utilities/sequencer/stm32_seq.c ****   }
 451:Utilities/sequencer/stm32_seq.c **** 
 452:Utilities/sequencer/stm32_seq.c ****   /*
 453:Utilities/sequencer/stm32_seq.c ****    * Restore the CurrentTaskIdx that may have been modified by call of UTIL_SEQ_Run() from UTIL_SEQ
 454:Utilities/sequencer/stm32_seq.c ****    * This is required so that a second call of UTIL_SEQ_WaitEvt() in the same process pass the corr
 455:Utilities/sequencer/stm32_seq.c ****    * in the call of UTIL_SEQ_EvtIdle()
 456:Utilities/sequencer/stm32_seq.c ****    */
 457:Utilities/sequencer/stm32_seq.c ****   CurrentTaskIdx = current_task_idx;
 458:Utilities/sequencer/stm32_seq.c **** 
 459:Utilities/sequencer/stm32_seq.c ****   UTIL_SEQ_ENTER_CRITICAL_SECTION( );
 460:Utilities/sequencer/stm32_seq.c **** 
 461:Utilities/sequencer/stm32_seq.c ****   EvtSet &= (~EvtId_bm);
 462:Utilities/sequencer/stm32_seq.c **** 
 463:Utilities/sequencer/stm32_seq.c ****   UTIL_SEQ_EXIT_CRITICAL_SECTION( );
 464:Utilities/sequencer/stm32_seq.c **** 
 465:Utilities/sequencer/stm32_seq.c ****   EvtWaited = event_waited_id_backup;
 466:Utilities/sequencer/stm32_seq.c ****   return;
 467:Utilities/sequencer/stm32_seq.c **** }
