 164:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_rcc_ex.c ****     {
 165:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_rcc_ex.c ****       case RCC_SAI1CLKSOURCE_PLL:      /* PLL is used as clock source for SAI1 */
