 158:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_rcc_ex.c ****   if ((((PeriphClkInit->PeriphClockSelection) & RCC_PERIPHCLK_SAI1) == RCC_PERIPHCLK_SAI1))
