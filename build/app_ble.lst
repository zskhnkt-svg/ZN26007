1177:STM32_WPAN/App/app_ble.c **** const uint8_t* BleGetBdAddress(void)
1178:STM32_WPAN/App/app_ble.c **** {
1179:STM32_WPAN/App/app_ble.c ****   uint8_t *p_otp_addr;
1180:STM32_WPAN/App/app_ble.c ****   const uint8_t *p_bd_addr;
1181:STM32_WPAN/App/app_ble.c ****   uint32_t udn;
1182:STM32_WPAN/App/app_ble.c ****   uint32_t company_id;
1183:STM32_WPAN/App/app_ble.c ****   uint32_t device_id;
1184:STM32_WPAN/App/app_ble.c **** 
1185:STM32_WPAN/App/app_ble.c ****   udn = LL_FLASH_GetUDN();
1186:STM32_WPAN/App/app_ble.c **** 
1187:STM32_WPAN/App/app_ble.c ****   if (udn != 0xFFFFFFFF)
1188:STM32_WPAN/App/app_ble.c ****   {
1189:STM32_WPAN/App/app_ble.c ****     company_id = LL_FLASH_GetSTCompanyID();
1190:STM32_WPAN/App/app_ble.c ****     device_id = LL_FLASH_GetDeviceID();
1191:STM32_WPAN/App/app_ble.c **** 
1192:STM32_WPAN/App/app_ble.c ****     /**
1193:STM32_WPAN/App/app_ble.c ****      * Public Address with the ST company ID
1194:STM32_WPAN/App/app_ble.c ****      * bit[47:24] : 24bits (OUI) equal to the company ID
1195:STM32_WPAN/App/app_ble.c ****      * bit[23:16] : Device ID.
1196:STM32_WPAN/App/app_ble.c ****      * bit[15:0] : The last 16bits from the UDN
1197:STM32_WPAN/App/app_ble.c ****      * Note: In order to use the Public Address in a final product, a dedicated
1198:STM32_WPAN/App/app_ble.c ****      * 24bits company ID (OUI) shall be bought.
1199:STM32_WPAN/App/app_ble.c ****      */
1200:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[0] = (uint8_t)(udn & 0x000000FF);
1201:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[1] = (uint8_t)((udn & 0x0000FF00) >> 8);
1202:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[2] = (uint8_t)device_id;
1203:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[3] = (uint8_t)(company_id & 0x000000FF);
1204:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[4] = (uint8_t)((company_id & 0x0000FF00) >> 8);
1205:STM32_WPAN/App/app_ble.c ****     a_BdAddrUdn[5] = (uint8_t)((company_id & 0x00FF0000) >> 16);
1206:STM32_WPAN/App/app_ble.c **** 
1207:STM32_WPAN/App/app_ble.c ****     p_bd_addr = (const uint8_t *)a_BdAddrUdn;
1208:STM32_WPAN/App/app_ble.c ****   }
1209:STM32_WPAN/App/app_ble.c ****   else
1210:STM32_WPAN/App/app_ble.c ****   {
1211:STM32_WPAN/App/app_ble.c ****     p_otp_addr = OTP_Read(0);
1212:STM32_WPAN/App/app_ble.c ****     if (p_otp_addr)
1213:STM32_WPAN/App/app_ble.c ****     {
1214:STM32_WPAN/App/app_ble.c ****       p_bd_addr = ((OTP_ID0_t*)p_otp_addr)->bd_address;
1215:STM32_WPAN/App/app_ble.c ****     }
1216:STM32_WPAN/App/app_ble.c ****     else
1217:STM32_WPAN/App/app_ble.c ****     {
1218:STM32_WPAN/App/app_ble.c ****       p_bd_addr = a_MBdAddr;
1219:STM32_WPAN/App/app_ble.c ****     }
1220:STM32_WPAN/App/app_ble.c ****   }
1221:STM32_WPAN/App/app_ble.c **** 
1222:STM32_WPAN/App/app_ble.c ****   return p_bd_addr;
1223:STM32_WPAN/App/app_ble.c **** }
